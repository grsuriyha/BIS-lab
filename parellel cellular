   "source": [
    "import numpy as np\n",
    "\n",
    "# Objective function\n",
    "def fitness(x):\n",
    "    return x**2 - 4*x + 4\n",
    "\n",
    "\n",
    "# Initialize parameters\n",
    "GRID_SIZE = 10\n",
    "ITERATIONS = 100\n",
    "LOWER_BOUND = -10\n",
    "UPPER_BOUND = 10\n",
    "\n",
    "# Initialize population randomly\n",
    "cells = np.random.uniform(\n",
    "    LOWER_BOUND,\n",
    "    UPPER_BOUND,\n",
    "    (GRID_SIZE, GRID_SIZE)\n",
    ")\n",
    "\n",
    "# Evaluate initial fitness\n",
    "fitness_values = fitness(cells)\n",
    "\n",
    "# Store global best solution\n",
    "best_index = np.unravel_index(\n",
    "    np.argmin(fitness_values),\n",
    "    fitness_values.shape\n",
    ")\n",
    "\n",
    "best_x = cells[best_index]\n",
    "best_fitness = fitness(best_x)\n",
    "\n",
    "\n",
    "# Cellular algorithm\n",
    "for iteration in range(ITERATIONS):\n",
    "\n",
    "    new_cells = cells.copy()\n",
    "\n",
    "    # Visit every cell\n",
    "    for i in range(GRID_SIZE):\n",
    "        for j in range(GRID_SIZE):\n",
    "\n",
    "            # Get 3x3 neighborhood (excluding boundaries)\n",
    "            neighbors = []\n",
    "\n",
    "            for di in range(-1, 2):\n",
    "                for dj in range(-1, 2):\n",
    "\n",
    "                    ni = i + di\n",
    "                    nj = j + dj\n",
    "\n",
    "                    # Check valid grid position\n",
    "                    if (0 <= ni < GRID_SIZE and\n",
    "                        0 <= nj < GRID_SIZE):\n",
    "\n",
    "                        neighbors.append(cells[ni, nj])\n",
    "\n",
    "            # Find neighbor with minimum fitness\n",
    "            neighbors = np.array(neighbors)\n",
    "\n",
    "            best_neighbor = neighbors[\n",
    "                np.argmin(fitness(neighbors))\n",
    "            ]\n",
    "\n",
    "            # Update cell using average\n",
    "            new_cells[i, j] = (\n",
    "                cells[i, j] + best_neighbor\n",
    "            ) / 2\n",
    "\n",
    "    # Replace old population\n",
    "    cells = np.clip(\n",
    "        new_cells,\n",
    "        LOWER_BOUND,\n",
    "        UPPER_BOUND\n",
    "    )\n",
    "\n",
    "    # Evaluate new fitness\n",
    "    fitness_values = fitness(cells)\n",
    "\n",
    "    # Find current best cell\n",
    "    current_index = np.unravel_index(\n",
    "        np.argmin(fitness_values),\n",
    "        fitness_values.shape\n",
    "    )\n",
    "\n",
    "    current_best_x = cells[current_index]\n",
    "    current_best_fitness = fitness(current_best_x)\n",
    "\n",
    "    # Update global best\n",
    "    if current_best_fitness < best_fitness:\n",
    "        best_x = current_best_x\n",
    "        best_fitness = current_best_fitness\n",
    "\n",
    "# Display results\n",
    "print(\"Parallel Cellular Algorithm Results\")\n",
    "print(\"------------------------------------\")\n",
    "print(\"Best value of x:\", best_x)\n",
    "print(\"Minimum fitness:\", best_fitness)\n",
    "print(\"Number of cells:\", GRID_SIZE * GRID_SIZE)\n",
    "print(\"Iterations:\", ITERATIONS)\n"
   ]
